{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "github-copilot",
    "ollama",
    "opencode"
  ],
  "permission": {
    "bash": {
      "ag *": "allow",
      "cat *": "allow",
      "diff *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "go test *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "which *": "allow"
    }
  }
}
